   "source": [
    "def age_grp(age):\n",
    "    if age<25:\n",
    "        return \"young\"\n",
    "    elif age<45:\n",
    "        return \"adult\"\n",
    "    elif age<60:\n",
    "        return \"middle_age\"\n",
    "    else:\n",
    "        return \"senior\""
   ]
  },

   "source": [
    "def life_risk(row):\n",
    "    if row[\"smoker\"] and row[\"bmi\"]>30:\n",
    "        return \"high\"\n",
    "    elif row[\"smoker\"] or row[\"bmi\"]>27:\n",
    "        return \"medium\"\n",
    "    else:\n",
    "        return \"low\""
   ]
  },
